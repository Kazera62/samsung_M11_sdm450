From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kernel Build <noreply@example.invalid>
Subject: [PATCH] usb: gadget: hid: log configfs HID bind lifecycle on 4.9

Add explicit messages when f_hid creates or removes /dev/hidgN and include
the bind error code. This is diagnostic only: a HID gadget node still appears
only after a HID function is configured and the composite gadget is bound to a UDC.

---
 drivers/usb/gadget/function/f_hid.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/usb/gadget/function/f_hid.c b/drivers/usb/gadget/function/f_hid.c
--- a/drivers/usb/gadget/function/f_hid.c
+++ b/drivers/usb/gadget/function/f_hid.c
@@ -750,9 +750,10 @@ static int hidg_bind(struct usb_configuration *c, struct usb_function *f)
 	device = device_create(hidg_class, NULL, dev, NULL,
 			       "%s%d", "hidg", hidg->minor);
 	if (IS_ERR(device)) {
 		status = PTR_ERR(device);
 		goto del;
 	}
+	pr_info("f_hid: registered /dev/hidg%d (HID gadget bound)\n", hidg->minor);
 
 	return 0;
 del:
@@ -766,6 +767,7 @@ static int hidg_bind(struct usb_configuration *c, struct usb_function *f)
 fail_free_descs:
 	usb_free_all_descriptors(f);
 fail:
+	pr_err("f_hid: hidg_bind failed (%d)\n", status);
 	ERROR(f->config->cdev, "hidg_bind FAILED\n");
 	if (hidg->req != NULL)
 		free_ep_req(hidg->in_ep, hidg->req);
@@ -1000,8 +1002,9 @@ static void hidg_unbind(struct usb_configuration *c, struct usb_function *f)
 {
 	struct f_hidg *hidg = func_to_hidg(f);
 
+	pr_info("f_hid: removing /dev/hidg%d (HID gadget unbound)\n", hidg->minor);
 	device_destroy(hidg_class, MKDEV(major, hidg->minor));
 	cdev_del(&hidg->cdev);
 
 	usb_free_all_descriptors(f);
 }
-- 
2.43.0
